# Copy to .env.local and fill in. Vite-prefixed VITE_* vars are exposed to the
# browser; do not put any secret values here.

# Backend (FastAPI) base URL if not co-hosted with Vite. Leave blank to use the
# Vite dev-server proxy at /api -> http://localhost:8000.
# VITE_API_BASE=http://localhost:8000

# Where the local database lives (sessions + multi-reviewer projects). Defaults
# to ~/.evidence-engine/evidence.db. Set this in the BACKEND environment.
# EE_DB_PATH=/absolute/path/to/evidence.db

# ---------------------------------------------------------------------------
# Emailing project invitations (BACKEND environment only; these are secrets).
# Without these, the Projects tab still works: it creates a one-time link for
# you to share yourself. With them, entering a reviewer's address sends it.
#
# Any SMTP server (institutional Exchange, Gmail with an app password, Fastmail,
# or an SMTP relay from Resend/SendGrid/Postmark):
# EE_SMTP_HOST=smtp.example.edu
# EE_SMTP_PORT=587                 # 465 switches to implicit TLS automatically
# EE_SMTP_USER=review@example.edu
# EE_SMTP_PASSWORD=app-password-not-your-login-password
# EE_MAIL_FROM=Evidence Engine <review@example.edu>
# EE_MAIL_REPLY_TO=you@example.edu
#
# Or the Resend HTTPS API, for hosts that block outbound SMTP:
# EE_RESEND_API_KEY=re_...
#
# EE_MAIL_TRANSPORT=auto           # auto | smtp | resend | console | off
#                                  # console prints the mail to the backend log
# EE_APP_ORIGIN=https://review.example.edu   # origin for invite links; defaults to
#                                  # the request Origin, then http://localhost:5173
